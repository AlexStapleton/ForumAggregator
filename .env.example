# Copy to .env next to docker-compose.yml.

# REQUIRED. Encrypts stored forum passwords and the 2FA secret. Generate once and keep it:
#   openssl rand -base64 48
# Changing it later makes stored secrets unreadable (you'd re-enter them).
FA_SECRET_KEY=

# Which proxies may tell the app the real client IP / https (X-Forwarded-*).
# Default covers localhost and private networks (Docker, LAN). Narrow it to your
# Nginx Proxy Manager's IP if you like, e.g. 172.18.0.5 or 192.168.1.10
#TRUST_PROXY=loopback,uniquelocal

# Optional: use Postgres instead of the built-in SQLite file.
#DATABASE_URL=postgres://user:password@host:5432/forumaggregator

# Optional single sign-on (Authelia/Authentik) — see docs/DEPLOY.md before enabling.
#AUTH_MODE=local            # local | proxy | both
#AUTH_PROXY_HEADER=Remote-User
#AUTH_PROXY_TRUSTED=172.18.0.5

#SESSION_TTL_DAYS=30
#LOG_LEVEL=info
