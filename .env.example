# Optional. ForumAggregator runs without any of these; copy to .env next to
# docker-compose.yml only for what you want to change.

# User/group the app runs as inside the container (and owns the data folder).
#PUID=1000
#PGID=1000

# Encryption key for stored secrets. Leave unset and one is generated on first start
# (kept in the data folder as secret.key). Set it only if you manage secrets yourself:
#   openssl rand -base64 48
#FA_SECRET_KEY=

# Which proxies may tell the app the real client IP / https (X-Forwarded-*).
# The default covers localhost and private networks (Docker, LAN).
#TRUST_PROXY=loopback,uniquelocal

# Postgres instead of SQLite (or use docker-compose.postgres.yml).
#DATABASE_URL=postgres://user:password@host:5432/forumaggregator

# Optional single sign-on (Authelia/Authentik). Read docs/DEPLOY.md first.
#AUTH_MODE=local            # local | proxy | both
#AUTH_PROXY_HEADER=Remote-User
#AUTH_PROXY_TRUSTED=172.18.0.5

#SESSION_TTL_DAYS=30
#SESSION_MAX_DAYS=90
# Who may set X-Forwarded-For/-Proto. Default trusts private addresses; narrowing it to NPM's
# address is recommended (docs/DEPLOY.md §3).
#TRUST_PROXY=loopback,uniquelocal
#LOG_LEVEL=info

# Internal feeds/articles are blocked by default. Exact origins only (scheme, host, port),
# comma-separated; no wildcards or paths. Every account may request an allowed origin.
# Pass these through your Compose service's environment or env_file as well.
#FA_ALLOWED_INTERNAL_ORIGINS=http://feeds.internal:8080
